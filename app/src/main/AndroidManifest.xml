<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required on Android 11+ to detect installed messengers -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.viber.voip" />
        <package android:name="com.viber.calls" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="im.molly.app" />
        <package android:name="org.telegram.plus" />
        <package android:name="com.nicegram.app" />
        <package android:name="org.nagramx.messenger" />
        <package android:name="app.nicegram" />
        <package android:name="com.bitchute.nagram" />
        <package android:name="nekogram.x" />
        <package android:name="tw.nekomimi.nekogram" />
        <!-- Query all launcher apps for messenger picker -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexusConnect"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NexusConnect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.DirectCallActivity"
            android:exported="false"
            android:theme="@style/Theme.NexusConnect.Transparent"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".widget.ContactChooserActivity"
            android:exported="false"
            android:theme="@style/Theme.NexusConnect.Transparent"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <receiver
            android:name=".widget.ContactWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.toxictrace.nexusconnect.ACTION_CONTACT_CLICK" />
                <action android:name="com.toxictrace.nexusconnect.ACTION_OPEN_CALL_LOG" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- ContactWidgetService kept for future use but not active -->
        <service
            android:name=".widget.ContactWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".widget.ContactsObserverService"
            android:exported="false" />

        <!-- Wakes up widget update after any call ends, even if app is killed -->
        <receiver
            android:name=".widget.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Avatar ContentProvider — serves default silhouette and custom avatar at full quality -->
        <provider
            android:name=".widget.AvatarProvider"
            android:authorities="com.toxictrace.nexusconnect.avatar"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- Photo ContentProvider for widget — bypasses IPC bitmap limit -->
        <provider
            android:name=".widget.PhotoProvider"
            android:authorities="com.toxictrace.nexusconnect.photos"
            android:exported="true"
            android:grantUriPermissions="true" />


        <!-- Restores widget after app update or device reboot -->
        <receiver
            android:name=".widget.BootAndUpdateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
