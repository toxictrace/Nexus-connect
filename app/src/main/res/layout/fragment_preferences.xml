<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Appearance -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Appearance" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Customize how Nexus Connect looks on your device." android:textSize="14sp" android:textColor="@color/colorOnSurfaceVariant" android:layout_marginBottom="16dp" />

        <!-- Theme -->
        <RadioGroup
            android:id="@+id/radio_group_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLight"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/colorPrimary">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:gravity="bottom">
                    <RadioButton android:id="@+id/radio_light" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Light" android:checked="true" android:buttonTint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDark"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1C1C1E"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:gravity="bottom">
                    <RadioButton android:id="@+id/radio_dark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dark" android:textColor="#FFFFFF" android:buttonTint="#FFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </RadioGroup>

        <RadioButton android:id="@+id/radio_system" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Follow System" android:buttonTint="@color/colorPrimary" android:layout_marginBottom="16dp" />

        <!-- Dynamic Colors -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorOutline">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dynamic Colors" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Use system colors for a cohesive look (Monet)" android:textSize="13sp" android:textColor="@color/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_dynamic_colors" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Click Action header -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GLOBAL ACTION" android:textSize="12sp" android:textColor="@color/colorOnSurfaceVariant" android:letterSpacing="0.1" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select the primary behavior when tapping a contact tile." android:textSize="14sp" android:textColor="@color/colorOnSurfaceVariant" android:layout_marginBottom="12dp" />

        <RadioGroup android:id="@+id/radio_group_click_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/colorPrimary">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_grid" android:tint="@color/colorPrimary" android:padding="8dp" android:background="@drawable/bg_circle_primary_light" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Show selection dialog" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prompt for app choice on every click" android:textSize="13sp" android:textColor="@color/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <RadioButton android:id="@+id/radio_show_dialog" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:buttonTint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_call" android:tint="@color/colorOnSurfaceVariant" android:padding="8dp" android:background="@drawable/bg_circle_surface" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Direct Call" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dial the primary number immediately" android:textSize="13sp" android:textColor="@color/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <RadioButton android:id="@+id/radio_direct_call" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_person" android:tint="@color/colorOnSurfaceVariant" android:padding="8dp" android:background="@drawable/bg_circle_surface" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open Profile" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View full contact details and history" android:textSize="13sp" android:textColor="@color/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <RadioButton android:id="@+id/radio_open_profile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </RadioGroup>

        <!-- Priority App -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRIORITY APP" android:textSize="12sp" android:textColor="@color/colorOnSurfaceVariant" android:letterSpacing="0.1" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select the preferred communication channel." android:textSize="14sp" android:textColor="@color/colorOnSurfaceVariant" android:layout_marginBottom="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="24dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_phone" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="Phone" android:textSize="12sp" android:drawableTop="@drawable/ic_call" app:cornerRadius="16dp" style="@style/Widget.Material3.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_whatsapp" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="WhatsApp" android:textSize="12sp" android:drawableTop="@drawable/ic_message" app:cornerRadius="16dp" style="@style/Widget.Material3.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_telegram" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="Telegram" android:textSize="12sp" android:drawableTop="@drawable/ic_send" app:cornerRadius="16dp" style="@style/Widget.Material3.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_viber" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="Viber" android:textSize="12sp" android:drawableTop="@drawable/ic_phone_alt" app:cornerRadius="16dp" style="@style/Widget.Material3.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Haptic feedback -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorOutline">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_vibrate" android:tint="@color/colorOnSurfaceVariant" android:padding="8dp" android:background="@drawable/bg_circle_surface" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Haptic Feedback" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vibrate on interaction" android:textSize="13sp" android:textColor="@color/colorOnSurfaceVariant" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_haptic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Avatar Identity -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avatar Identity" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="16dp" />

        <RadioGroup android:id="@+id/radio_group_avatar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/colorOutline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_person" android:tint="@color/colorOnSurfaceVariant" android:padding="10dp" android:background="@drawable/bg_circle_surface" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System Default" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Generic silhouette based on account status" android:textSize="13sp" android:textColor="@color/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <RadioButton android:id="@+id/radio_avatar_system" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="2dp" app:strokeColor="@color/colorPrimary">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <com.google.android.material.card.MaterialCardView android:layout_width="44dp" android:layout_height="44dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="@color/colorPrimary" app:cardElevation="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="JD" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dynamic Initials" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your first and last name initials on theme color" android:textSize="13sp" android:textColor="@color/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <RadioButton android:id="@+id/radio_avatar_initials" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:buttonTint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/colorOutline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_photo" android:tint="@color/colorOnSurfaceVariant" android:padding="10dp" android:background="@drawable/bg_circle_surface" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Photos Only" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prioritize actual profile pictures when available" android:textSize="13sp" android:textColor="@color/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <RadioButton android:id="@+id/radio_avatar_photos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </RadioGroup>

        <!-- Import / Export buttons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="24dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_import_settings" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="Import Settings" android:drawableStart="@drawable/ic_download" app:cornerRadius="28dp" style="@style/Widget.Material3.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_export_settings" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Export Settings" android:drawableStart="@drawable/ic_upload" app:cornerRadius="28dp" style="@style/Widget.Material3.Button" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
